# Copy this file to .env and fill in your real key. Never commit .env.
OPENAI_API_KEY=

# S3-compatible storage (local dev: MinIO via docker-compose.yml). See src/storage.py.
# These defaults work out of the box with `docker compose up` -- change them only if
# you're pointing at a different MinIO/S3 instance.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=dataagent
S3_SECRET_ACCESS_KEY=dataagent-local
S3_BUCKET=data-agent

# Java home for PySpark (e.g. /opt/homebrew/opt/openjdk@17 via `brew install openjdk@17`).
# See src/spark_session.py.
JAVA_HOME=

# --- RHOAI platform backends (src/config.py) --------------------------------------------
# All four default to the values below (the local path) if left unset -- only set these when
# running against RHOAI (see deploy/rhoai/configmap-app-config.yaml for the real deployed
# values). Never required for local development or `pytest`.
EXECUTION_BACKEND=local
RUNTIME_BACKEND=local
AGENT_HARNESS=current
STATE_BACKEND=file

# Only read when EXECUTION_BACKEND=rhoai / RUNTIME_BACKEND=spark_history / STATE_BACKEND=redis.
RHOAI_NAMESPACE=data-agent
RHOAI_SPARK_IMAGE=REPLACE_WITH_BUILT_SPARK_IMAGE
RHOAI_SECRET_NAME=data-agent-secrets
SPARK_HISTORY_SERVER_URL=http://spark-history-server:18080
REDIS_URL=redis://localhost:6379/0

# Only read by src.agents.codex_mcp_loop when connecting to deployed (not in-process) MCP
# servers -- see deploy/rhoai/mcp-*-deployment.yaml.
MCP_DATA_OPS_URL=http://mcp-data-ops:8000/mcp
MCP_SPARK_RUNTIME_URL=http://mcp-spark-runtime:8000/mcp
