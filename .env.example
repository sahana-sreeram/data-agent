# Copy this file to .env and fill in your real key. Never commit .env.
OPENAI_API_KEY=

# S3-compatible storage (local dev: MinIO via docker-compose.yml). See src/storage.py.
# These defaults work out of the box with `docker compose up` -- change them only if
# you're pointing at a different MinIO/S3 instance.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=dataagent
S3_SECRET_ACCESS_KEY=dataagent-local
S3_BUCKET=data-agent

# Java home for PySpark (e.g. /opt/homebrew/opt/openjdk@17 via `brew install openjdk@17`).
# See src/spark_session.py.
JAVA_HOME=
