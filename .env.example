# Copy this file to .env and fill in your real key. Never commit .env.
OPENAI_API_KEY=

# S3-compatible storage (local dev: MinIO). See src/storage.py.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Java home for PySpark (e.g. /opt/homebrew/opt/openjdk@17 via `brew install openjdk@17`).
# See src/spark_session.py.
JAVA_HOME=
